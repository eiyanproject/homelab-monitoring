# Host-specific values and secrets. Never commit.
.env

# Generated on the Proxmox host by scripts/gen-targets.sh
targets/guests.json
targets/services.json

# Local scratch
*.log
.DS_Store

# Generated from .env by scripts/render-alerting.sh - contains webhook URLs
# and bot tokens, so it must never be committed.
config/grafana/provisioning/alerting/contact-points.yml
config/grafana/provisioning/alerting/notification-policies.yml

# Generated from scrape.yml by scripts/render-scrape.sh (per-node value)
config/vmagent/scrape.active.yml

# Python bytecode - control/app.py and oci/watchdog.py both generate this
__pycache__/
*.pyc
