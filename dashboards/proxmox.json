{
  "uid": "hm-proxmox",
  "title": "Proxmox",
  "description": "Built for the metric names PVE's InfluxDB push actually produces (cpustat_*, blockstat_*, ballooninfo_*), which match neither the OTLP names nor the pve_* series that dashboards 10347/23855/24550 expect. Labels: object=nodes|lxc|qemu|storages, host=node or guest name, vmid, nodename.",
  "tags": ["homelab", "proxmox"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": "label_values(cpustat_cpu{object=\"nodes\"}, host)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "guest",
        "label": "Guest",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": "label_values(cpustat_cpu{object=~\"lxc|qemu\"}, host)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Nodes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Node CPU",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "cpustat_cpu{object=\"nodes\", host=~\"$node\"} * 100",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Node load average",
      "description": "cpustat_avg1 vs cpustat_cpus - load above the core count means work is queueing.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "cpustat_avg1{object=\"nodes\", host=~\"$node\"}", "legendFormat": "{{host}} 1m" },
        { "refId": "B", "expr": "cpustat_avg15{object=\"nodes\", host=~\"$node\"}", "legendFormat": "{{host}} 15m" },
        { "refId": "C", "expr": "cpustat_cpus{object=\"nodes\", host=~\"$node\"}", "legendFormat": "{{host}} cores" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*cores" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Node I/O wait",
      "description": "Sustained iowait means storage is the bottleneck, not CPU.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "cpustat_iowait{object=\"nodes\", host=~\"$node\"} * 100", "legendFormat": "{{host}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 18, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Guests",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Guest CPU",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "cpustat_cpu{object=~\"lxc|qemu\", host=~\"$guest\"} * 100",
          "legendFormat": "{{host}} ({{vmid}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1.5, "fillOpacity": 8, "showPoints": "never", "spanNulls": false }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "table",
      "title": "Guest filesystem usage",
      "description": "blockstat_used / blockstat_blocks. Available without node_exporter, because PVE reports it for the guest's own rootfs.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "(blockstat_used{host=~\"$guest\"} / blockstat_blocks{host=~\"$guest\"}) * 100",
          "instant": true,
          "format": "table",
          "legendFormat": "{{host}}"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "node": true, "object": true, "instance": true }, "renameByName": { "host": "Guest", "vmid": "VMID", "nodename": "Node", "Value": "Used %" } } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Used %", "desc": true }] } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Used %" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] } }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "type": "timeseries",
      "title": "Guest disk read",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "rate(blockstat_rd_bytes{host=~\"$guest\"}[5m])", "legendFormat": "{{host}} {{instance}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineWidth": 1.5, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Guest disk write",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "rate(blockstat_wr_bytes{host=~\"$guest\"}[5m])", "legendFormat": "{{host}} {{instance}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineWidth": 1.5, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "VM memory in use (balloon)",
      "description": "QEMU guests only, and only with the guest agent running. LXC memory comes from a different measurement.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "(ballooninfo_total_mem{host=~\"$guest\"} - ballooninfo_free_mem{host=~\"$guest\"}) / ballooninfo_total_mem{host=~\"$guest\"} * 100",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "VM swap activity",
      "description": "Non-zero here means the guest itself is short of memory, which the hypervisor's own numbers will not show you.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "rate(ballooninfo_mem_swapped_in{host=~\"$guest\"}[5m])", "legendFormat": "{{host}} in" },
        { "refId": "B", "expr": "rate(ballooninfo_mem_swapped_out{host=~\"$guest\"}[5m])", "legendFormat": "{{host}} out" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
