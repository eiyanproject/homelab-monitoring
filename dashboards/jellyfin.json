      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "system_cpu{host=\"Jellyfin\"} * 100",
          "range": true
        }
      ],
      "description": "PVE reports system_cpu as a fraction of total cores, not a percentage. The container is allocated 6 cores, so 100% here means all six saturated.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
