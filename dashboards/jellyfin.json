{
  "uid": "hm-jellyfin",
  "title": "Jellyfin",
  "description": "Jellyfin (CT 100 on eiyan). Guest rows come from the agentless PVE push; application rows from Jellyfin's own /metrics endpoint, enabled via EnableMetrics in /var/lib/jellyfin/config/system.xml. Sessions, transcodes and per-user activity are not in that endpoint - those need an API-polling exporter.",
  "tags": [
    "homelab",
    "service"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
