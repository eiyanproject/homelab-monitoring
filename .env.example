# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored - nothing here reaches GitHub.
#
# The SAME repo builds both nodes. Only the first three values differ.
# ---------------------------------------------------------------------------

# --- Per-node identity ------------------------------------------------------
# Becomes the `node` label on every metric this agent collects.
NODE_NAME=node-a

# The OTHER node's IP. Its VictoriaMetrics receives a copy of everything.
PEER_IP=192.168.0.0

# Alerting runs on ONE node only, or every alert arrives twice forever.
#   primary node:  ./config/grafana/provisioning/alerting
#   standby node:  ./config/grafana/provisioning/alerting-disabled
# Promoting the standby is a change to this one line + `docker compose up -d`.
ALERTING_DIR=./config/grafana/provisioning/alerting

# --- Access -----------------------------------------------------------------
# These apply only when Grafana's database is first created. To change them on
# a running install, use the control panel - it calls Grafana's API and writes
# the new values back here.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-first-start
GRAFANA_ROOT_URL=http://192.168.0.0:3000

# Control panel on :8080 - start/stop Grafana, promote this node, read logs.
# It is always running (it has to be: it is what starts Grafana), and it can
# reach the Docker socket, so treat this password as root on this container.
# Change CONTROL_PORT if 8080 is taken on this host.
CONTROL_PORT=8080
CONTROL_USER=admin
CONTROL_PASSWORD=change-me-too

# Absolute path to this repo ON THE HOST. The control panel mounts it, and the
# path must match inside and out for compose operations to resolve correctly.
PROJECT_DIR=/srv/monitoring

# Lean mode: create Grafana but leave it stopped, saving ~317 MB. Use on the
# node with less RAM to spare. It still receives and stores every metric - you
# just start the UI from the control panel when you want to look at it.
LEAN_MODE=false

# Bind published ports to this address. 0.0.0.0 exposes on the LAN.
# Set to 127.0.0.1 if you front everything with a tunnel instead.
BIND_ADDR=0.0.0.0

# --- Retention and buffering ------------------------------------------------
METRICS_RETENTION=90d
LOGS_RETENTION=30d

# Hard cap on the replication backlog held for the peer. Without this, a peer
# that stays down for a week fills the disk of the node that is still healthy,
# turning one dead node into two.
# Minimum accepted by vmagent is 512MB - anything lower is silently rounded up.
BUFFER_MAX=2GB

# --- Alert delivery (primary node only) -------------------------------------
# Easiest set from the control panel, which regenerates the provisioning files
# and restarts Grafana for you. If you edit them here by hand, afterwards run:
#     sh scripts/render-alerting.sh /srv/monitoring && docker restart hm-grafana
#
# These are NOT interpolated into a committed file. Grafana refuses to load a
# contact point with an empty url and crash-loops provisioning, so the config
# is generated and an unconfigured channel is simply absent.
# ntfy: the topic URL, e.g. https://ntfy.sh/your-secret-topic-name
NTFY_URL=

# Discord: Server Settings > Integrations > Webhooks > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Telegram: talk to @BotFather for the token, @userinfobot for the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
